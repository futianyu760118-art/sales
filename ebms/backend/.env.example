# EBMS 后端环境变量（复制为 .env 后填写，.env 不入库）
PORT=3020
NODE_ENV=development

# PostgreSQL（EBMS 自有数据底座）
EBMS_DB_HOST=127.0.0.1
EBMS_DB_PORT=5433
EBMS_DB_NAME=ebms
EBMS_DB_USER=ebms
EBMS_DB_PASSWORD=

# 鉴权签名密钥（用于签发/校验操作人 token）；生产环境必须由部署环境注入
EBMS_AUTH_SECRET=
EBMS_TOKEN_TTL_SECONDS=28800

# 上传附件落地目录
EBMS_UPLOAD_DIR=./var/uploads
