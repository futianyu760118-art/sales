{
  "version": "1.0",
  "updated_at": "2026-07-15 12:34:50",
  "description": "物料库自检规则库。每条规则对应一类问题；运行后产生问题记录入库（material_check_issues.json），责任人跟进到闭环。",
  "severity_levels": {
    "critical": "严重：影响业务正确性（如编码重复、关键字段缺失）",
    "high": "高：违反明文标准（如代码格式、单位非标）",
    "medium": "中：建议优化（如分类未填、长度超标）",
    "low": "低：提示性（如可读性、备用名缺失）"
  },
  "default_severity": "medium",
  "scope_labels": {
    "material": "单条物料",
    "global": "全表级"
  },
  "rules": [
    {
      "id": "CODE-001",
      "category": "code",
      "name": "物料代码格式标准",
      "severity": "high",
      "scope": "material",
      "field": "material_code",
      "description": "编码必须符合 [大类].[中类].[小类].[代号]-[序号] 格式，如 1.5.1.LSS-10X28",
      "check_type": "regex",
      "pattern": "^[1-4]\\.\\d+\\.\\d+\\.[A-Za-z0-9]+-[A-Za-z0-9\\-]+$",
      "remediation": "按 database/material_coding_rules.json 第2段映射重命名为标准编码。建议保留旧编码作为 alias 字段。",
      "auto_fix": "rename_by_rule",
      "enabled": true
    },
    {
      "id": "CODE-002",
      "category": "code",
      "name": "物料代码重复",
      "severity": "critical",
      "scope": "global",
      "field": "material_code",
      "description": "同一物料代码只能对应一条记录",
      "check_type": "unique",
      "remediation": "保留一条主记录，其它重复记录须重新分配编码或合并",
      "enabled": true
    },
    {
      "id": "NAME-001",
      "category": "name",
      "name": "物料名称长度限制",
      "severity": "low",
      "scope": "material",
      "field": "material_name",
      "description": "名称长度应介于 3-30 字之间，便于显示和检索",
      "check_type": "length_range",
      "min": 3,
      "max": 30,
      "remediation": "精简名称，把规格/图纸号/版本拆到单独字段 (specs / version)",
      "enabled": true
    },
    {
      "id": "NAME-002",
      "category": "name",
      "name": "物料名称禁用占位词",
      "severity": "low",
      "scope": "material",
      "field": "material_name",
      "description": "名称不得含「未确认」「待定」「TBD」「TODO」等占位词",
      "check_type": "forbidden_contains",
      "forbidden": [
        "未确认",
        "待定",
        "TBD",
        "TODO",
        "占位",
        "未知"
      ],
      "remediation": "移除占位词，补全实际名称；若信息不完整，先修改备注而不是名称",
      "enabled": true
    },
    {
      "id": "NAME-003",
      "category": "name",
      "name": "物料名称禁用特殊字符",
      "severity": "medium",
      "scope": "material",
      "field": "material_name",
      "description": "名称不得含 < > / \\ | 等特殊字符，会破坏搜索和导出",
      "check_type": "forbidden_chars",
      "forbidden": [
        "<",
        ">",
        "/",
        "\\",
        "|"
      ],
      "remediation": "替换为中文标点（（）《》／）或移除",
      "enabled": true
    },
    {
      "id": "UNIT-001",
      "category": "unit",
      "name": "单位标准化",
      "severity": "high",
      "scope": "material",
      "field": "unit",
      "description": "单位必须是 6 个标准枚举之一：PCS / g / kg / ml / m / t",
      "check_type": "enum",
      "allowed": [
        "PCS",
        "g",
        "kg",
        "ml",
        "m",
        "t"
      ],
      "empty_ok": false,
      "remediation": "按 database/material_unit_standards.json 的 unit_unify 映射自动转换（同义词归一）",
      "auto_fix": "unify_unit",
      "enabled": true
    },
    {
      "id": "UNIT-002",
      "category": "unit",
      "name": "价格类物料单位错误",
      "severity": "critical",
      "scope": "material",
      "field": "unit",
      "description": "加工费/服务费等价格类物料不应使用「人民币」等单位，应使用专门的 cost_unit 字段",
      "check_type": "forbidden_value",
      "forbidden_values": [
        "人民币",
        "元",
        "$",
        "RMB"
      ],
      "remediation": "把单位改为「次」「PCS」等度量单位，价格放到 standard_cost 字段",
      "enabled": true
    },
    {
      "id": "CLASS-001",
      "category": "classification",
      "name": "物料分类字段填充",
      "severity": "medium",
      "scope": "material",
      "field": "classification",
      "description": "classification 字段不得为「通用物料」兜底（除非真的属于通用类）或为空",
      "check_type": "field_present",
      "expected_choices": [
        "结构类物料",
        "电子类物料",
        "包材类物料",
        "附件类物料",
        "光学件",
        "五金件",
        "紧固件",
        "线材类",
        "辅料",
        "通用物料",
        "常用物料",
        "定制物料",
        "专用物料"
      ],
      "remediation": "按编码第2段（中类小类）反推。详见 material_coding_rules.json",
      "auto_fix": "infer_from_code_segment",
      "enabled": true,
      "auto_fix_segment": 2,
      "auto_fix_map": {
        "1.1": "光学件",
        "1.2": "光学件",
        "1.3": "光学件",
        "1.4": "五金件",
        "1.5": "紧固件",
        "1.6": "电子类物料",
        "1.7": "包材类物料",
        "1.8": "线材类",
        "2.3": "结构类物料",
        "2.4": "结构类物料",
        "2.6": "结构类物料",
        "4.9": "辅料",
        "default": "通用物料"
      },
      "auto_fix_fallback": "通用物料"
    },
    {
      "id": "CLASS-002",
      "category": "classification",
      "name": "物料类型字段填充",
      "severity": "high",
      "scope": "material",
      "field": "material_type",
      "description": "material_type 必须是「外购 / 委外加工 / 自制」之一，对应编码第1段",
      "check_type": "enum",
      "allowed": [
        "外购",
        "委外加工",
        "自制"
      ],
      "remediation": "按编码第1段：1→外购，2→自制，3→委外加工，4→辅料",
      "auto_fix": "infer_from_code_segment",
      "auto_fix_segment": 1,
      "auto_fix_map": {
        "1": "外购",
        "2": "自制",
        "3": "委外加工",
        "4": "辅料"
      },
      "enabled": true
    },
    {
      "id": "CLASS-003",
      "category": "classification",
      "name": "category 业务类别字段填充",
      "severity": "low",
      "scope": "material",
      "field": "category",
      "description": "category 字段应当填写实际业务类别（如 外购/委外加工/自制），为空时建议从 BOM.attr 反推",
      "check_type": "field_present",
      "remediation": "同步 BOM 的 material_attr 字段，或从编码第1段反推",
      "auto_fix": "infer_from_code_segment",
      "auto_fix_segment": 1,
      "auto_fix_map": {
        "1": "外购",
        "2": "自制",
        "3": "委外加工",
        "4": "辅料"
      },
      "enabled": true
    },
    {
      "id": "BOM-001",
      "category": "bom",
      "name": "BOM 行物料未在物料库",
      "severity": "high",
      "scope": "bom",
      "description": "BOM 表中引用的物料代码在物料库中找不到",
      "check_type": "bom_orphan_code",
      "remediation": "在物料库中补充该物料，或将 BOM 行删除/更正",
      "enabled": true
    },
    {
      "id": "DATA-001",
      "category": "integrity",
      "name": "物料关键字段完整性",
      "severity": "medium",
      "scope": "material",
      "field": "standard_cost",
      "description": "标准成本应 > 0（外购件至少记录采购参考价）",
      "check_type": "numeric_gt",
      "field_value": 0,
      "remediation": "从 BOM.unit_price 反推，或从采购订单最近成交价填充",
      "auto_fix": "sync_cost_from_bom",
      "enabled": true
    },
    {
      "id": "DATA-002",
      "category": "integrity",
      "name": "认证要求字段三态化",
      "severity": "low",
      "scope": "material",
      "field": "certificate_required",
      "description": "certificate_required 不得全为 0；区分不需要 / 需要 / 已认证",
      "check_type": "field_audit_only",
      "remediation": "对关键/认证件标 1，已认证物料标 2",
      "enabled": true
    }
  ],
  "issue_statuses": {
    "open": "待处理",
    "in_progress": "跟进中",
    "resolved": "已解决",
    "ignored": "已忽略",
    "wont_fix": "暂不修复"
  },
  "issue_severity_color": {
    "critical": "#c0392b",
    "high": "#e74c3c",
    "medium": "#f39c12",
    "low": "#3498db"
  }
}