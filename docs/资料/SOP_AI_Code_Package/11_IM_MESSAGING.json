  "integration_with_external_im": {
    "_comment": "与企业微信/钉钉/飞书的对接方案",
    "wechat_work": {
      "enabled": true,
      "app_id": "env:WECHAT_WORK_APP_ID",
      "app_secret": "env:WECHAT_WORK_APP_SECRET",
      "corp_id": "env:WECHAT_WORK_CORP_ID",
      "push_methods": [
        { "type": "应用消息", "api": "POST https://qyapi.weixin.qq.com/cgi-bin/message/send", "usage": "预警/Action/会议邀请推送" },
        { "type": "群机器人Webhook", "api": "POST {webhook_url}", "usage": "部门群/KPI播报/自检报告" },
        { "type": "小程序通知", "usage": "移动端快速审批/确认" }
      ],
      "user_mapping": "sys_user.user_code ↔ 企业微信userid"
    },
    "dingtalk": {
      "enabled": false,
      "note": "如客户使用钉钉，配置类似企业微信",
      "push_methods": [
        { "type": "工作通知", "api": "DingTalk OpenAPI" },
        { "type": "群机器人", "api": "Webhook" }
      ]
    },
    "feishu": {
      "enabled": false,
      "note": "如客户使用飞书，配置类似",
      "push_methods": [
        { "type": "消息卡片", "api": "Feishu OpenAPI" }
      ]
    },
    "sms": {
      "enabled": true,
      "provider": "阿里云短信 / 腾讯云短信(二选一)",
      "usage": "P0 Action逾期 / 硬拦截 / 客诉SLA违约",
      "template_mapping": {
        "action_overdue": "SMS_001",
        "block_triggered": "SMS_002",
        "meeting_reminder": "SMS_003"
      }
    },
    "email": {
      "enabled": true,
      "provider": "SMTP / SendGrid / 阿里云邮件推送",
      "usage": "会议邀请/纪要/周报/月报",
      "templates": ["meeting_invite.html", "weekly_report.html", "monthly_kpi.html", "action_overdue.html"]
    }
  },

  "frontend_im_layout": {
    "_comment": "前端IM模块布局描述 — 可直接给React组件用",
    "layout": "three_column_or_drawer",
    "columns": [
      {
        "name": "会话列表",
        "width": "280px",
        "components": [
          { "type": "SearchBar", "placeholder": "搜索会话/消息..." },
          { "type": "TabBar", "tabs": ["全部","未读","@我","系统"] },
          { "type": "ConvList", "props": {
            "items_source": "im_conversation + unread_count",
            "sort_by": "last_msg_at DESC",
            "show_badge": true,
            "show_pinned_on_top": true,
            "context_menu": ["置顶","免打扰","标记已读","归档","删除"]
          }}
        ]
      },
      {
        "name": "消息区域",
        "width": "flex-1",
        "components": [
          { "type": "ConvHeader", "props": { "show_name": true, "show_members": true, "show_actions": ["搜索","置顶","免打扰","更多"] } },
          { "type": "MessageList", "props": {
            "virtual_scroll": true,
            "load_more_on_scroll_top": true,
            "message_types": ["TEXT","IMAGE","FILE","VOICE","SYSTEM","ALERT","ACTION_CARD","MEETING_CARD"],
            "features": ["引用回复","@提及高亮","Emoji反应","长按菜单","已读回执图标"],
            "auto_scroll_to_bottom_on_new": true
          }},
          { "type": "ComposerBar", "props": {
            "features": ["文本输入","表情面板",":快捷命令","@提及","附件上传","语音录音","消息模板"],
            "slash_commands": ["/create-action","/check-kpi","/psi","/alert","/meeting","/help"],
            "send_on_enter": true,
            "ctrl_enter_newline": true
          }}
        ]
      },
      {
        "name": "详情面板(可折叠)",
        "width": "320px",
        "components": [
          { "type": "MemberList", "props": { "show_online_status": true, "@_user_jump": true } },
          { "type": "RelatedBusinessCard", "props": {
            "show_when": "conv.related_type != GENERAL",
            "types": {
              "MEETING": "显示会议摘要+议程+决议",
              "ACTION": "显示Action详情+进度+证据",
              "ALERT": "显示预警详情+升级路径",
              "PSI": "显示PSI数据卡片",
              "KPI": "显示KPI趋势图"
            }
          }},
          { "type": "MessageSearch", "props": { "scope": "当前会话", "fulltext_search": true } }
        ]
      }
    ],
    "global_im_entry": {
      "type": "FloatingButton + Drawer",
      "position": "右下角(类似企业微信)",
      "badge": "总未读数",
      "click_action": "打开IM抽屉(不离开当前页面)"
    },
    "mobile_responsive": {
      "breakpoint": "768px",
      "mobile_layout": "单栏切换(会话列表↔消息区域↔详情)"
    }
  },

  "backend_implementation_guide": {
    "_comment": "给AI编程工具的后端实现指引",
    "websocket_server": {
      "framework": "Python FastAPI WebSocket / Node.js Socket.IO",
      "connection_url": "ws://localhost:8000/ws/im/{user_id}?token={jwt}",
      "auth": "JWT验证 → 绑定user_id → 加入user_room",
      "heartbeat": "每30秒ping/pong",
      "reconnect": "指数退避(1s→2s→4s→8s→16s, 最大30s)"
    },
    "message_flow": {
      "step1": "客户端发送消息 → WebSocket → 服务端校验+持久化到im_message",
      "step2": "服务端生成im_message_receipt记录(SENT状态)",
      "step3": "服务端通过WebSocket推送给会话所有在线成员",
      "step4": "离线成员 → 查询im_notification_rule → 按channel_priority推送外部通道",
      "step5": "接收方客户端收到 → 更新last_read_msg_id → 回执READ",
      "step6": "服务端更新receipt状态 → 通知发送方'已读'"
    },
    "push_dispatch_logic": {
      "input": "一条待推送消息 + 目标用户ID列表",
      "step1": "查询每个用户的im_notification_rule",
      "step2": "检查免打扰时段(quiet_hours)",
      "step3": "检查消息优先级(ALERT/BLOCK跳过免打扰)",
      "step4": "按channel_priority顺序尝试推送",
      "step5": "WebSocket在线 → 直接推送; 不在线 → 微信/短信/邮件",
      "step6": "写im_push_log记录每次推送结果",
      "step7": "失败重试(指数退避, 最多3次)"
    },
    "api_endpoints": [
      { "method": "GET", "path": "/im/conversations", "desc": "获取会话列表(含未读数)" },
      { "method": "POST", "path": "/im/conversations", "desc": "创建会话(单聊/群聊/系统)" },
      { "method": "GET", "path": "/im/conversations/{conv_id}/messages", "desc": "获取消息历史(分页/游标)" },
      { "method": "POST", "path": "/im/conversations/{conv_id}/messages", "desc": "发送消息(文本/文件/卡片)" },
      { "method": "PUT", "path": "/im/messages/{msg_id}/recall", "desc": "撤回消息(2分钟内)" },
      { "method": "PUT", "path": "/im/messages/{msg_id}/read", "desc": "标记已读" },
      { "method": "PUT", "path": "/im/conversations/{conv_id}/read-all", "desc": "标记会话全部已读" },
      { "method": "GET", "path": "/im/conversations/{conv_id}/members", "desc": "获取成员列表+在线状态" },
      { "method": "POST", "path": "/im/conversations/{conv_id}/members", "desc": "添加成员" },
      { "method": "DELETE", "path": "/im/conversations/{conv_id}/members/{user_id}", "desc": "移除成员" },
      { "method": "PUT", "path": "/im/conversations/{conv_id}/mute", "desc": "设置免打扰" },
      { "method": "PUT", "path": "/im/conversations/{conv_id}/pin", "desc": "置顶/取消置顶" },
      { "method": "GET", "path": "/im/search", "desc": "全局消息搜索" },
      { "method": "GET", "path": "/im/notifications/settings", "desc": "获取我的通知偏好" },
      { "method": "PUT", "path": "/im/notifications/settings", "desc": "更新通知偏好" },
      { "method": "POST", "path": "/im/push/external", "desc": "手动触发外部推送(测试用)" },
      { "method": "WS", "path": "/ws/im/{user_id}", "desc": "WebSocket连接(实时消息)" },
      { "method": "WS-EMIT", "event": "system:broadcast", "desc": "系统管理员向全员广播" }
    ],
    "celery_tasks": [
      { "task": "push_to_external_channel", "desc": "异步推送微信/短信/邮件", "queue": "push" },
      { "task": "check_action_overdue", "desc": "每5分钟扫描逾期Action并推送升级通知", "queue": "scheduler" },
      { "task": "check_alert_escalation", "desc": "每小时检查预警升级条件", "queue": "scheduler" },
      { "task": "cleanup_old_messages", "desc": "每天清理Redis热缓存(保留DB永久)", "queue": "maintenance" },
      { "task": "weekly_self_check_push", "desc": "每周一08:00推送自检报告", "queue": "scheduler" },
      { "task": "daily_kpi_report_push", "desc": "每天08:00推送前日KPI摘要", "queue": "scheduler" }
    ]
  }
}
