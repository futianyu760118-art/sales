{
  "_comment": "S&OP系统 IM即时通讯模块 — 消息提醒/对话/群聊/预警推送/已读回执",
  "version": "1.0",
  "updated_at": "2026-07-30",

  "overview": {
    "description": "在S&OP系统中内嵌IM模块，实现预警实时推送、Action待办提醒、RAPID表决讨论、会议协同对话、群聊协作等场景",
    "tech_stack": {
      "realtime_channel": "WebSocket (Socket.IO / FastAPI WebSocket)",
      "push_channels": ["WebSocket", "站内信", "企业微信/钉钉Webhook", "短信(SMS)", "邮件(Email)"],
      "message_store": "MySQL + Redis(缓存最近7天热消息)",
      "file_transfer": "MinIO / 阿里云OSS(图片/文件/语音)"
    },
    "integration_points": [
      "预警引擎 → IM实时推送",
      "Action待办 → IM到期提醒+升级通知",
      "会议管理 → IM会中讨论+RAPID表决",
      "PSI协同 → IM@提及+评论",
      "硬拦截 → IM弹窗+责任人通知",
      "自检引擎 → IM每周报告推送"
    ]
  },

  "data_models": {
    "_comment": "以下为6张IM相关表，完整DDL见01_DATABASE_DDL.sql",
    "im_conversation": {
      "_comment": "会话表(单聊/群聊/系统通知/会议聊天室)",
      "table_name": "im_conversation",
      "fields": {
        "id": "BIGINT PRIMARY KEY AUTO_INCREMENT",
        "conv_type": "ENUM('SINGLE','GROUP','SYSTEM','MEETING_ROOM') NOT NULL DEFAULT 'SINGLE'",
        "conv_name": "VARCHAR(256) DEFAULT NULL",
        "owner_id": "BIGINT NOT NULL COMMENT '创建者user_id'",
        "related_type": "ENUM('MEETING','ACTION','ALERT','PSI','KPI','GENERAL') DEFAULT 'GENERAL'",
        "related_id": "BIGINT DEFAULT NULL",
        "is_active": "TINYINT DEFAULT 1",
        "last_msg_at": "DATETIME DEFAULT NULL",
        "last_msg_preview": "VARCHAR(512) DEFAULT NULL",
        "created_at": "DATETIME DEFAULT CURRENT_TIMESTAMP"
      },
      "indexes": [
        "INDEX idx_owner (owner_id)",
        "INDEX idx_related (related_type, related_id)",
        "INDEX idx_last_msg (last_msg_at DESC)"
      ]
    },
    "im_conversation_member": {
      "_comment": "会话成员表",
      "table_name": "im_conversation_member",
      "fields": {
        "id": "BIGINT PRIMARY KEY AUTO_INCREMENT",
        "conv_id": "BIGINT NOT NULL",
        "user_id": "BIGINT NOT NULL",
        "role": "ENUM('OWNER','ADMIN','MEMBER') DEFAULT 'MEMBER'",
        "is_muted": "TINYINT DEFAULT 0",
        "is_pinned": "TINYINT DEFAULT 0",
        "unread_count": "INT DEFAULT 0",
        "last_read_msg_id": "BIGINT DEFAULT 0",
        "joined_at": "DATETIME DEFAULT CURRENT_TIMESTAMP",
        "left_at": "DATETIME DEFAULT NULL"
      },
      "indexes": [
        "UNIQUE KEY uk_conv_user (conv_id, user_id)",
        "INDEX idx_user (user_id)",
        "FOREIGN KEY (conv_id) REFERENCES im_conversation(id) ON DELETE CASCADE"
      ]
    },
    "im_message": {
      "_comment": "消息表(所有消息类型统一存储)",
      "table_name": "im_message",
      "fields": {
        "id": "BIGINT PRIMARY KEY AUTO_INCREMENT",
        "conv_id": "BIGINT NOT NULL",
        "sender_id": "BIGINT NOT NULL COMMENT '发送者(0=系统)'",
        "msg_type": "ENUM('TEXT','IMAGE','FILE','VOICE','VIDEO','SYSTEM','ALERT','ACTION_REMINDER','MEETING_INVITE','RAPID_VOTE','QUOTE_REPLY','EMOJI_REACTION','RECALL') NOT NULL DEFAULT 'TEXT'",
        "content": "TEXT DEFAULT NULL",
        "rich_content_json": "JSON DEFAULT NULL",
        "reply_to_msg_id": "BIGINT DEFAULT NULL",
        "is_recalled": "TINYINT DEFAULT 0",
        "recalled_at": "DATETIME DEFAULT NULL",
        "created_at": "DATETIME DEFAULT CURRENT_TIMESTAMP"
      },
      "indexes": [
        "INDEX idx_conv_time (conv_id, created_at DESC)",
        "INDEX idx_sender (sender_id)",
        "FOREIGN KEY (conv_id) REFERENCES im_conversation(id) ON DELETE CASCADE"
      ]
    },
    "im_message_receipt": {
      "_comment": "消息已读回执",
      "table_name": "im_message_receipt",
      "fields": {
        "id": "BIGINT PRIMARY KEY AUTO_INCREMENT",
        "msg_id": "BIGINT NOT NULL",
        "user_id": "BIGINT NOT NULL",
        "status": "ENUM('SENT','DELIVERED','READ') DEFAULT 'SENT'",
        "read_at": "DATETIME DEFAULT NULL",
        "delivered_at": "DATETIME DEFAULT NULL"
      },
      "indexes": [
        "UNIQUE KEY uk_msg_user (msg_id, user_id)",
        "INDEX idx_user_status (user_id, status)",
        "FOREIGN KEY (msg_id) REFERENCES im_message(id) ON DELETE CASCADE"
      ]
    },
    "im_notification_rule": {
      "_comment": "用户级通知偏好设置",
      "table_name": "im_notification_rule",
      "fields": {
        "id": "BIGINT PRIMARY KEY AUTO_INCREMENT",
        "user_id": "BIGINT NOT NULL UNIQUE",
        "alert_realtime_push": "TINYINT DEFAULT 1",
        "action_reminder_push": "TINYINT DEFAULT 1",
        "meeting_invite_push": "TINYINT DEFAULT 1",
        "psi_update_push": "TINYINT DEFAULT 0",
        "kpi_report_push": "TINYINT DEFAULT 1",
        "self_check_push": "TINYINT DEFAULT 1",
        "quiet_hours_start": "TIME DEFAULT '22:00'",
        "quiet_hours_end": "TIME DEFAULT '08:00'",
        "allow_at_mention_bypass": "TINYINT DEFAULT 1",
        "channel_priority": "JSON DEFAULT '[\\\"WEBSOCKET\\\",\\\"WECHAT_WORK\\\",\\\"SMS\\\",\\\"EMAIL\\\"]'"
      }
    },
    "im_push_log": {
      "_comment": "外部推送日志(微信/短信/邮件)",
      "table_name": "im_push_log",
      "fields": {
        "id": "BIGINT PRIMARY KEY AUTO_INCREMENT",
        "msg_id": "BIGINT DEFAULT NULL",
        "channel": "ENUM('WEBSOCKET','WECHAT_WORK','DINGTALK','FEISHU','SMS','EMAIL','IN_APP') NOT NULL",
        "target_user_id": "BIGINT NOT NULL",
        "target_address": "VARCHAR(256) DEFAULT NULL",
        "status": "ENUM('PENDING','SENT','DELIVERED','READ','FAILED') DEFAULT 'PENDING'",
        "response_code": "VARCHAR(32) DEFAULT NULL",
        "response_msg": "TEXT DEFAULT NULL",
        "sent_at": "DATETIME DEFAULT CURRENT_TIMESTAMP",
        "retry_count": "TINYINT DEFAULT 0"
      },
      "indexes": [
        "INDEX idx_msg (msg_id)",
        "INDEX idx_target_status (target_user_id, status)",
        "INDEX idx_sent_at (sent_at)"
      ]
    }
  },

  "auto_generated_conversations": {
    "_comment": "系统自动创建/管理的会话",
    "rules": [
      {
        "trigger": "会议创建时",
        "action": "自动创建MEETING_ROOM类型会话，添加所有出席人员",
        "conv_name_tpl": "S&OP会议-{meeting_code}",
        "auto_invite": "所有meeting_attendee",
        "welcome_msg": "【系统】会议{meeting_code}已创建，时间：{meeting_date}。请准时参加。"
      },
      {
        "trigger": "Action创建/指派时",
        "action": "自动在责任人和协作者之间创建SINGLE对话(如不存在)",
        "welcome_msg_tpl": "【系统】您有一个新的Action待办：{action_code} - {description}，截止日期：{due_date}，优先级：{priority}"
      },
      {
        "trigger": "预警触发时",
        "action": "系统自动向notify_roles中所有用户发送SYSTEM类型消息",
        "msg_tpl": "⚠️【{alert_level}】{rule_name}：{message}"
      },
      {
        "trigger": "硬拦截触发时",
        "action": "创建紧急GROUP(含责任人+工程主管+计委主任)，发送BLOCK类型消息",
        "msg_tpl": "⛔【硬拦截】{block_type}：{block_reason}。请立即处理。",
        "auto_escalate": "每4h未解除自动升级"
      },
      {
        "trigger": "每周一08:00自检完成",
        "action": "向SOP_OFFICER和各部门主管推送自检报告",
        "msg_tpl": "📋【每周自检报告】本周评分：{total_score}分({grade})，通过{passed}/{total}项。详情请查看系统。"
      }
    ]
  },

  "message_templates": {
    "_comment": "系统消息模板(支持变量替换+富文本卡片)",
    "templates": [
      {
        "tpl_code": "TPL-ALERT-R",
        "msg_type": "ALERT",
        "title": "🔴 红灯预警",
        "content_tpl": "【{rule_name}】\n等级：🔴 红色告警\n内容：{message}\n触发时间：{triggered_at}\n\n请立即处理，超时将自动升级。",
        "rich_card": {
          "type": "alert_card",
          "buttons": [
            { "label": "查看详情", "action": "navigate:/sop/alerts/{alert_id}" },
            { "label": "确认收到", "action": "api:PUT /alerts/logs/{alert_id}/acknowledge" },
            { "label": "创建Action", "action": "navigate:/sop/actions/new?alert_id={alert_id}" }
          ]
        },
        "push_channels": ["WEBSOCKET", "WECHAT_WORK", "SMS"]
      },
      {
        "tpl_code": "TPL-ALERT-Y",
        "msg_type": "ALERT",
        "title": "🟡 黄灯预警",
        "content_tpl": "【{rule_name}】\n等级：🟡 黄色提醒\n内容：{message}\n\n建议关注，必要时采取行动。",
        "rich_card": {
          "type": "alert_card",
          "buttons": [
            { "label": "查看详情", "action": "navigate:/sop/kpi/{kpi_id}" }
          ]
        },
        "push_channels": ["WEBSOCKET", "WECHAT_WORK"]
      },
      {
        "tpl_code": "TPL-ACTION-ASSIGN",
        "msg_type": "ACTION_REMINDER",
        "title": "📌 新待办指派",
        "content_tpl": "【{priority}级待办】{description}\n编号：{action_code}\n截止：{due_date}\n责任人：{owner_name}\n来源：{source_system}",
        "rich_card": {
          "type": "action_card",
          "buttons": [
            { "label": "立即处理", "action": "navigate:/sop/actions/{action_id}" },
            { "label": "标记进行中", "action": "api:PUT /actions/{action_id}/status with IN_PROGRESS" },
            { "label": "转派他人", "action": "modal:reassign_action" }
          ]
        },
        "push_channels": ["WEBSOCKET", "WECHAT_WORK", "SMS"]
      },
      {
        "tpl_code": "TPL-ACTION-OVERDUE",
        "msg_type": "ACTION_REMINDER",
        "title": "🚨 待办逾期",
        "content_tpl": "【逾期告警】您的待办已逾期{overdue_days}天！\n编号：{action_code}\n描述：{description}\n优先级：{priority}\n升级层级：{escalation_level}",
        "rich_card": {
          "type": "action_card",
          "style": "urgent",
          "buttons": [
            { "label": "立即处理(紧急)", "action": "navigate:/sop/actions/{action_id}", "highlight": true },
            { "label": "申请延期", "action": "modal:request_extension" },
            { "label": "查看升级路径", "action": "navigate:/sop/actions/{action_id}#escalation" }
          ]
        },
        "push_channels": ["WEBSOCKET", "WECHAT_WORK", "SMS", "EMAIL"],
        "escalation_cascade": "逾期1天→短信, 3天→邮件抄送主管, 7天→微信抄送副总"
      },
      {
        "tpl_code": "TPL-MEETING-INVITE",
        "msg_type": "MEETING_INVITE",
        "title": "📅 会议邀请",
        "content_tpl": "【S&OP会议邀请】\n会议编号：{meeting_code}\n类型：{meeting_type}\n时间：{meeting_date}\n关联PSI：{psi_code}\n\n请准时参加，议程已自动生成。",
        "rich_card": {
          "type": "meeting_card",
          "buttons": [
            { "label": "确认出席", "action": "api:PUT /meetings/{id}/rsvp with ACCEPT" },
            { "label": "请假/委派", "action": "modal:delegate_meeting" },
            { "label": "查看议程", "action": "navigate:/sop/meetings/{id}#agenda" }
          ]
        },
        "push_channels": ["WEBSOCKET", "WECHAT_WORK", "EMAIL"]
      },
      {
        "tpl_code": "TPL-MEETING-DECISION",
        "msg_type": "SYSTEM",
        "title": "📋 会议决议通知",
        "content_tpl": "【会议决议】{meeting_code}已关闭\n决议摘要：{decision_summary}\n\n已自动生成{actions_count}条Action待办，请各责任人查收。",
        "rich_card": {
          "type": "decision_card",
          "buttons": [
            { "label": "查看全部Action", "action": "navigate:/sop/actions?meeting_id={meeting_id}" },
            { "label": "下载会议纪要", "action": "api:GET /meetings/{id}/export" }
          ]
        },
        "push_channels": ["WEBSOCKET", "WECHAT_WORK", "EMAIL"]
      },
      {
        "tpl_code": "TPL-BLOCK-TRIGGER",
        "msg_type": "ALERT",
        "title": "⛔ 硬拦截告警",
        "content_tpl": "【硬拦截触发】\n类型：{block_type}\n对象：{entity_code}\n原因：{block_reason}\n\n⚠️ 该拦截不可绕过，请工程部立即处理。",
        "rich_card": {
          "type": "block_card",
          "style": "critical",
          "buttons": [
            { "label": "联系工程部", "action": "navigate:/sop/im?user=ENGINEER_HEAD" },
            { "label": "查看详情", "action": "navigate:/sop/supply#block-check" }
          ]
        },
        "push_channels": ["WEBSOCKET", "WECHAT_WORK", "SMS", "EMAIL"],
        "notify_roles": ["ENGINEER_HEAD", "COMMITTEE_HEAD"]
      },
      {
        "tpl_code": "TPL-PSI-UPDATE",
        "msg_type": "SYSTEM",
        "title": "📊 PSI更新通知",
        "content_tpl": "【PSI更新】{psi_code} 状态变更为 {status}\n产品：{product_code}\nM月期末：{inv_end_m0}\nM+1期末：{inv_end_m1}\n\n{color_summary}",
        "rich_card": {
          "type": "psi_card",
          "buttons": [
            { "label": "查看PSI", "action": "navigate:/sop/psi/{header_id}" }
          ]
        },
        "push_channels": ["WEBSOCKET"]
      },
      {
        "tpl_code": "TPL-SELF-CHECK-REPORT",
        "msg_type": "SYSTEM",
        "title": "📋 每周自检报告",
        "content_tpl": "【每周自检】{week_no}\n总评分：{total_score}分 ({grade})\n✅ 通过：{passed}项\n❌ 未通过：{failed}项\n\n未通过项已自动创建Action。",
        "rich_card": {
          "type": "report_card",
          "buttons": [
            { "label": "查看报告", "action": "navigate:/sop/self-check?week={week_no}" },
            { "label": "查看Action", "action": "navigate:/sop/actions?source=self_check" }
          ]
        },
        "push_channels": ["WEBSOCKET", "WECHAT_WORK", "EMAIL"]
      },
      {
        "tpl_code": "TPL-KPI-REPORT",
        "msg_type": "SYSTEM",
        "title": "📈 KPI月报",
        "content_tpl": "【KPI月报】{period_month}\n🔴 红灯：{red_count}项\n🟡 黄灯：{yellow_count}项\n🟢 绿灯：{green_count}项\n\n{top3_red_kpis}",
        "rich_card": {
          "type": "kpi_card",
          "buttons": [
            { "label": "查看驾驶舱", "action": "navigate:/sop/dashboard" },
            { "label": "查看红灯详情", "action": "navigate:/sop/kpi?status=R" }
          ]
        },
        "push_channels": ["WEBSOCKET", "WECHAT_WORK", "EMAIL"]
      }
    ]
  },

  "realtime_events": {
    "_comment": "WebSocket实时事件清单 — 前端需监听并响应",
    "events": [
      {
        "event": "alert:triggered",
        "payload": { "alert_id": "int", "level": "R/Y/BLOCK", "rule_name": "string", "message": "string", "link": "string" },
        "frontend_action": "① 右上角弹出Toast通知(可点击跳转) ② 侧边栏铃铛+1 ③ 如BLOCK级别→弹模态框"
      },
      {
        "event": "action:assigned",
        "payload": { "action_id": "int", "description": "string", "due_date": "date", "priority": "P0/P1/P2" },
        "frontend_action": "① 待办看板新增卡片 ② Toast通知 ③ 如P0→弹确认对话框"
      },
      {
        "event": "action:overdue",
        "payload": { "action_id": "int", "overdue_days": "int", "escalation_level": "int" },
        "frontend_action": "① 卡片变红色+闪烁 ② 持续Toast(每5min) ③ 发送短信/微信"
      },
      {
        "event": "meeting:invite",
        "payload": { "meeting_id": "int", "meeting_code": "string", "meeting_date": "datetime", "type": "string" },
        "frontend_action": "① 弹会议邀请卡片 ② 日历新增提醒 ③ 邮件通知"
      },
      {
        "event": "meeting:decision_made",
        "payload": { "meeting_id": "int", "decision": "string", "actions_generated": "int" },
        "frontend_action": "① 刷新Action列表 ② 弹决议摘要 ③ 自动跳转Action页"
      },
      {
        "event": "psi:updated",
        "payload": { "header_id": "int", "product_code": "string", "color_status": "R/Y/G" },
        "frontend_action": "① 刷新PSI表格对应行 ② 如变R→Toast提醒"
      },
      {
        "event": "psi:locked",
        "payload": { "header_id": "int", "locked_by": "string" },
        "frontend_action": "① PSI表格切换为只读 ② 通知所有编辑者"
      },
      {
        "event": "block:triggered",
        "payload": { "block_type": "string", "entity_code": "string", "reason": "string" },
        "frontend_action": "① 全屏模态框(不可关闭) ② 持续蜂鸣提醒 ③ 通知工程部+主管"
      },
      {
        "event": "block:released",
        "payload": { "block_type": "string", "entity_code": "string", "released_by": "string" },
        "frontend_action": "① 关闭模态框 ② Toast通知已解除 ③ 刷新供应评审页"
      },
      {
        "event": "self_check:completed",
        "payload": { "week_no": "string", "score": "number", "grade": "A/B/C/D" },
        "frontend_action": "① 弹报告摘要 ② 如D级→通知总经理 ③ 跳转自检详情"
      },
      {
        "event": "kpi:updated",
        "payload": { "kpi_code": "string", "actual_value": "number", "status": "R/Y/G" },
        "frontend_action": "① 刷新驾驶舱对应卡片 ② 如变R→红色闪烁"
      },
      {
        "event": "message:new",
        "payload": { "conv_id": "int", "sender_name": "string", "content_preview": "string", "msg_type": "string" },
        "frontend_action": "① 聊天列表置顶+未读+1 ② Toast(如@我) ③ 播放提示音"
      },
      {
        "event": "message:recall",
        "payload": { "msg_id": "int", "conv_id": "int" },
        "frontend_action": "① 消息内容替换为'已撤回' ② 保留占位行"
      },
      {
        "event": "rapid:vote_cast",
        "payload": { "meeting_id": "int", "agenda_item": "int", "voter": "string", "vote": "AGREE/VETO/ABSTAIN" },
        "frontend_action": "① 刷新表决进度条 ② 如全员投完→显示结果"
      }
    ]
  },

  "chat_features": {
    "_comment": "IM对话功能特性",
    "features": [
      {
        "name": "@提及",
        "description": "在群聊中@某人，被@者收到特殊通知(即使群已免打扰)",
        "implementation": {
          "parse": "正则匹配 @用户名 → 替换为user_id",
          "notify": "被@用户 → WebSocket推送 + 微信/短信(如开启@通知)",
          "highlight": "消息中@部分高亮显示 + 跳转锚点"
        }
      },
      {
        "name": "消息撤回",
        "description": "2分钟内可撤回自己的消息",
        "implementation": {
          "time_limit_seconds": 120,
          "restriction": "仅发送者可撤回;系统消息不可撤回",
          "ui": "长按消息→撤回;撤回后显示'XXX撤回了一条消息'"
        }
      },
      {
        "name": "引用回复",
        "description": "引用某条消息进行回复，形成对话线索",
        "implementation": {
          "ui": "右键/长按消息→引用回复;上方显示被引消息摘要",
          "storage": "reply_to_msg_id字段关联",
          "render": "缩进显示+连线(类似Slack Thread)"
        }
      },
      {
        "name": "已读回执",
        "description": "显示消息已读/未读状态，群聊显示已读人数",
        "implementation": {
          "single_chat": "显示'已读'/'未读'/'已送达'",
